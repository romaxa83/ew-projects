        "production": "cross-env NODE_ENV=production node_modules/webpack/bin/webpack.js --no-progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
        "postinstall": "node ./node_modules/datatables.net-editor/install.js ./resources/js/Editor-1.9.2.zip",
        "dev-up": "docker compose -f docker-compose.localhost.yml up -d && npm run dev-exec",
        "dev-exec": "docker exec -it H2HMovers-Dev__nodejs sh",
        "dev-down": "docker compose -f docker-compose.localhost.yml down --remove-orphans",
        "build-smartadmin-ui": "cd resources/smartadmin-html-full && yarn install && npm run build"
    },
